# LLM (required for chat)
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.inceptionlabs.ai/v1
USER_LLM_MODEL=mercury-2

# Optional aliases used by older setups
MERCURY_API_KEY=your-api-key-here

# Optional tools
NEWS_API_KEY=your-newsapi-key-here
TINYFISH_KEY=your-tinyfish-key-here
PAXSENIX_API_KEY=your-paxsenix-key-here

# Optional runtime
JBOT_SANDBOX=.
JBOT_MAX_STEPS=8
JBOT_TIMEOUT=60
JBOT_TEMPERATURE=0.2
JBOT_HISTORY_LIMIT=20
